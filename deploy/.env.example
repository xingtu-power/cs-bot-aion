# ===== cs-bot-aion 部署配置模板 =====
# 用法: cp .env.example .env,按需修改(不要把 .env 提交进 git)

# 【必填】DeepSeek LLM API Key(在 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=

# LLM 模式:deepseek(默认)| rule(免 key 规则兜底)| none
CSAPP_LLM_MODE=deepseek

# 内部效果分析台(/admin)访问口令:设置后所有 /admin 与 /api/v1/admin/* 请求
# 需带请求头 X-Admin-Token;留空时仅允许本机回环(127.0.0.1/::1)访问。
CSAPP_ADMIN_TOKEN=

# 分析库(data/analytics.db)保留天数(默认 180);与会话 JSON(90 天)相互独立
# CSAPP_ANALYTICS_RETENTION_DAYS=180

# 公网监听端口(需与 ECS 安全组放行端口一致)
HOST_PORT=8000

# pip 源:国内 ECS 加速用阿里云镜像
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# 方式 A 云上构建时:1=把 2.3GB e5 模型打进镜像(云上首次零下载,镜像 ~3.6GB)
# BAKE_MODEL=0

# e5 模型下载源:国内 hf-mirror(默认)| 海外 ECS 用官方源
# HF_ENDPOINT=https://huggingface.co

# 时区
TZ=Asia/Shanghai
