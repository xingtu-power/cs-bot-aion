# 运行态数据(会话/业务库/调试日志)
data/

# 密钥(勿入库;模板见 deploy/.env.example)
.env
deploy/.env

# 本地导出的镜像包(手动上传用)
csbot-dist/

# 内嵌第三方库(需 pip 安装)
tools/pylib/
tools/_lib/

# 模型/依赖缓存(需下载/安装)
tools/emb_cache/
tools/hf_cache/
tools/pipcache/
tools/dsh_home/

# 生成物/系统文件
__pycache__/
*.pyc
*.pyo
.DS_Store
# 知识库页面图(由 tools/extract_images.py 生成)
kb/*/images/
